generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  flagEmoji         String
  region            String
  governmentType    String
  neutralProfile    String
  confidenceScore   Int
  lastVerifiedAt    DateTime
  leaders           LeaderRole[]
  snapshots         Snapshot[]
  sourceRecords     SourceRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model LeaderRole {
  id               String   @id @default(cuid())
  countryId        String
  roleType         String
  leaderName       String
  officialTitle    String
  assumedOffice    DateTime
  predecessor      String?
  affiliation      String?
  isCurrent        Boolean  @default(true)
  country          Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  timelineEntries  TimelineEntry[]
}

model TimelineEntry {
  id            String    @id @default(cuid())
  leaderRoleId  String
  assumedOffice DateTime
  endedOffice   DateTime?
  note          String?
  leaderRole    LeaderRole @relation(fields: [leaderRoleId], references: [id], onDelete: Cascade)
}

model SourceRecord {
  id               String   @id @default(cuid())
  countryId         String
  url              String
  publisher        String
  publisherType    String
  trustScore       Int
  verificationRun  String
  verifiedAt       DateTime
  country          Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId, verifiedAt])
}

model ConflictCase {
  id                 String   @id @default(cuid())
  countryCode         String
  roleType           String
  candidatePayload   Json
  confidenceSpread   Int
  status             String   @default("open")
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
  resolutionNote     String?
}

model Snapshot {
  id               String   @id @default(cuid())
  countryId         String
  payload          Json
  confidenceScore  Int
  capturedAt       DateTime @default(now())
  country          Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId, capturedAt])
}
